---
import { versioned } from '../lib/assets.js';
import BaseHead from '../components/BaseHead.astro';
import LoaderLogo from '../components/LoaderLogo.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="AeroNav Charts"
      shareTitle="AeroNav Chart Viewer"
      description="Browse every AeroNav chart for PTFS: STARs, SIDs, approaches and taxi diagrams, with live ATIS, a pinboard and scratchpads."
      keywords="AeroNav Charts"
      fonts="family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700"
      stylesheet="/css/app.css"
    />
  </head>
  <body>
    <div id="pageLoading" class="page-loading">
      <div class="loader-content">
        <LoaderLogo />
        <div class="spinner"></div>
        <div class="loading-text">Loading charts...</div>
      </div>
    </div>

    <div class="mobile-header">
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="mobile-logo">AeroNav Charts</div>
      <button class="mobile-search-toggle" id="mobileSearchToggle" aria-label="Toggle search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
    </div>

    <div class="app">
      <nav class="rail" aria-label="Sections">
        <a class="rail-btn" href="/" aria-label="Home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M3 10.5 12 3l9 7.5" />
            <path d="M5 9.5V21h14V9.5" />
          </svg>
          <span>Home</span>
        </a>
        <button class="rail-btn active" data-panel="airports" aria-label="Airports">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 3.5c.8 0 1.3.7 1.3 1.6v3.6l7 4v2l-7-2.1v4l2.3 1.6v1.7L12 19l-3.6.9v-1.7l2.3-1.6v-4l-7 2.1v-2l7-4V5.1c0-.9.5-1.6 1.3-1.6Z" />
          </svg>
          <span>Charts</span>
        </button>
        <button class="rail-btn" id="pinboardToggle" aria-label="Toggle pinboard" aria-pressed="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M9 3h6l-1 5 3 3v2H7v-2l3-3-1-5Z" />
            <path d="M12 13v8" />
          </svg>
          <span>Pinboard</span>
        </button>
        <button class="rail-btn" data-panel="route" aria-label="Route planner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="5.5" cy="18.5" r="2.2" />
            <circle cx="18.5" cy="5.5" r="2.2" />
            <path d="M7.5 17.5 11 14l2-4 3.5-3" />
          </svg>
          <span>Route</span>
        </button>
        <button class="rail-btn" data-panel="links" aria-label="Links">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M10 13a4 4 0 0 0 5.7.3l3-3A4 4 0 0 0 13 4.6l-1.4 1.4" />
            <path d="M14 11a4 4 0 0 0-5.7-.3l-3 3A4 4 0 0 0 11 19.4l1.4-1.4" />
          </svg>
          <span>Links</span>
        </button>
        <img class="rail-logo" src="/assets/aerologo.webp" alt="AeroNav Charts" />
      </nav>

      <aside class="panel" id="leftCol" aria-label="Airports and charts">
        <section class="panel-view active" id="viewAirports">
          <div class="panel-head airport-head">
            <div class="head-bar">
              <button class="head-btn hidden" id="backBtn" aria-label="Back to airports">Airports</button>
              <button class="head-btn" id="hideBtn" aria-label="Hide panel">Hide</button>
            </div>
            <div class="panel-heading">
              <div class="panel-title-row">
                <div class="panel-title" id="panelTitle">Airports</div>
                <button class="fav-btn hidden" id="favBtn" aria-pressed="false" aria-label="Add to favorites" title="Add to favorites">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
                    <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L12 3.5Z" />
                  </svg>
                </button>
              </div>
              <div class="panel-name" id="panelName"></div>
              <div class="panel-sub" id="panelSub">Select an airport to see its charts</div>
            </div>
            <div class="category-bar seg-bar hidden" id="airportTabs" role="tablist" aria-label="Airport sections">
              <button class="cat-btn" data-tab="info" role="tab">Info</button>
              <button class="cat-btn" data-tab="charts" role="tab">Charts</button>
              <button class="cat-btn" data-tab="proc" role="tab">Proc</button>
              <button class="cat-btn" data-tab="weather" role="tab" title="Current ATIS">Weather</button>
              <button class="cat-btn" data-tab="networks" role="tab" disabled title="Online network data isn't available for PTFS">Networks</button>
            </div>
            <div class="category-bar seg-bar hidden" id="infoTabs" role="tablist" aria-label="Airport info">
              <button class="cat-btn" data-info="general" role="tab">General</button>
              <button class="cat-btn" data-info="runways" role="tab">Runways</button>
              <button class="cat-btn" data-info="comms" role="tab">Comms</button>
              <button class="cat-btn" data-info="notam" role="tab">NOTAM</button>
            </div>
            <div class="category-bar seg-bar hidden" id="weatherTabs" role="tablist" aria-label="Weather">
              <button class="cat-btn" data-wx="metar" role="tab">METAR</button>
              <button class="cat-btn" data-wx="atis" role="tab">ATIS</button>
            </div>
          </div>

          <div class="search-wrap">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7" />
              <path d="m21 21-4.35-4.35" />
            </svg>
            <input id="leftSearch" class="search" placeholder="Filter charts and airports" />
            <button class="clear-btn" id="doneBtn" disabled aria-label="Clear search">Clear</button>
          </div>

          <div class="category-bar" id="categoryBar" style="display: none"></div>

          <div class="list" id="listArea">
            <div class="skeleton-loader" id="skeletonLoader">
              <div class="skeleton-item"></div>
              <div class="skeleton-item"></div>
              <div class="skeleton-item"></div>
              <div class="skeleton-item"></div>
            </div>
            <div class="empty-state" id="emptyState" style="display: none;">
              <div class="empty-title">Nothing matches that</div>
              <div class="empty-sub">Try a different ICAO code or chart name</div>
            </div>
            <div class="list-inner" id="listInner"></div>
          </div>

          <div class="install-nudge" id="installNudge" hidden>
            <div class="install-nudge-text">
              <strong>Install AeroNav</strong>
              <span id="installNudgeSub">Charts open instantly and work offline.</span>
            </div>
            <button class="install-nudge-go" id="installNudgeGo" type="button">Install</button>
            <button class="install-nudge-close" id="installNudgeClose" type="button" aria-label="Dismiss install suggestion">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          </div>

          <p class="panel-note">Does something look broken? Hard refresh (Ctrl+Shift+R) or clear your cache.</p>

          <div class="mobile-search-overlay" id="mobileSearchOverlay">
            <input id="mobileSearch" class="search mobile-search-input" placeholder="Search airports and charts..." />
          </div>
        </section>

        <section class="panel-view" id="viewRoute">
          <div class="route-screen" data-route-screen="airports" hidden>
            <div class="panel-head airport-head">
              <div class="head-bar">
                <button class="head-btn" id="routePickBack" type="button">New Flight</button>
                <button class="head-btn" id="routePickHide" type="button">Hide</button>
              </div>
              <div class="panel-heading">
                <div class="panel-title">Airports</div>
                <div class="panel-sub" id="routePickSub"></div>
              </div>
            </div>
            <div class="search-wrap">
              <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.35-4.35" />
              </svg>
              <input id="routePickSearch" class="search" placeholder="Search" autocomplete="off" spellcheck="false" aria-label="Search airports" />
            </div>
            <div class="list">
              <div class="list-group-header">Airport</div>
              <div id="routePickList"></div>
            </div>
          </div>
          <div class="route-screen" data-route-screen="flight">
          <div class="panel-head airport-head">
            <div class="head-bar">
              <button class="head-btn" id="routeClear" type="button">Unload</button>
              <button class="head-btn" id="routeHide" type="button">Hide</button>
            </div>
            <div class="panel-heading">
              <div class="panel-title" id="routeTitle">New Flight</div>
            </div>
            <div class="category-bar seg-bar" id="routeTabs" role="tablist" aria-label="Flight sections">
              <button class="cat-btn active" data-route-tab="general" role="tab" type="button">General</button>
              <button class="cat-btn" data-route-tab="routes" role="tab" type="button">Routes</button>
              <button class="cat-btn" data-route-tab="export" role="tab" type="button">Export</button>
            </div>
          </div>
          <div class="list">
            <div class="route-pane" data-route-pane="general">
              <div class="list-group-header">Origin</div>
              <div class="item-airport flight-row">
                <div class="airport-main">
                  <div class="airport-title" id="routeFromCode"></div>
                  <div class="airport-name" id="routeFromName"></div>
                  <div class="airport-sub" id="routeFromRwy"></div>
                </div>
                <button class="flight-select" data-route-pick="from" type="button" aria-label="Select origin airport">Select</button>
              </div>
              <div class="list-group-header">Destination</div>
              <div class="item-airport flight-row">
                <div class="airport-main">
                  <div class="airport-title" id="routeToCode"></div>
                  <div class="airport-name" id="routeToName"></div>
                  <div class="airport-sub" id="routeToRwy"></div>
                </div>
                <button class="flight-select" data-route-pick="to" type="button" aria-label="Select destination airport">Select</button>
              </div>
              <div class="flight-buttons">
                <button class="flight-btn" id="routeSwap" type="button">Swap Airports</button>
                <button class="flight-btn" id="routeFind" type="button">Find Routes</button>
              </div>
            </div>
            <div class="route-pane" data-route-pane="routes" hidden>
              <div class="list-group-header" id="routeCount">Routes</div>
              <p class="route-empty" id="routeEmpty"></p>
              <ol class="route-list" id="routeList"></ol>
              <p class="panel-note route-note" id="routeNote" hidden></p>
              <div class="flight-buttons" id="routeTools" hidden>
                <button class="flight-btn" id="routeShuffle" type="button">Shuffle Routes</button>
                <button class="flight-btn" id="routeEnroute" type="button">Show on Enroute</button>
              </div>
            </div>
            <div class="route-pane" data-route-pane="export" hidden>
              <div class="list-group-header">Flight Plan</div>
              <div id="routeDetails">
              <label class="flight-field">
                <span>In-game callsign</span>
                <input id="routeGameCallsign" type="text" placeholder="Jester-3263" autocomplete="off" spellcheck="false" />
              </label>
              <label class="flight-field">
                <span>Callsign</span>
                <input id="routeCallsign" type="text" placeholder="DAL123" autocomplete="off" spellcheck="false" autocapitalize="characters" />
              </label>
              <label class="flight-field">
                <span>Aircraft</span>
                <input id="routeAircraft" type="text" placeholder="B737" autocomplete="off" spellcheck="false" />
              </label>
              <label class="flight-field">
                <span>In-game name</span>
                <input id="routeGameName" type="text" placeholder="Roblox username" autocomplete="off" spellcheck="false" autocapitalize="off" />
              </label>
              <label class="flight-field">
                <span>Flight rules</span>
                <select id="routeRules"><option value="IFR">IFR</option><option value="VFR">VFR</option></select>
              </label>
              <label class="flight-field">
                <span>Flight level</span>
                <input id="routeLevel" type="text" inputmode="numeric" maxlength="3" placeholder="040" autocomplete="off" />
              </label>
              <label class="flight-field">
                <span>Cruise speed (kt)</span>
                <input id="routeSpeed" type="number" min="40" max="2000" step="10" inputmode="numeric" />
              </label>
              </div>
              <div class="list-group-header">Selected Route</div>
              <p class="route-empty" id="routeText"></p>
              <div class="flight-buttons" id="routeActions" hidden>
                <button class="flight-btn flight-btn-main" id="routeCommand" type="button">Copy Discord Command</button>
                <button class="flight-btn" id="routeCopy" type="button">Copy Route</button>
              </div>
            </div>
          </div>
          </div>
        </section>

        <section class="panel-view" id="viewLinks">
          <div class="panel-head">
            <div class="panel-heading">
              <div class="panel-title">Links</div>
              <div class="panel-sub">Tools from us and the community</div>
            </div>
          </div>
          <div class="list">
            <div class="link-list">
              <button class="link-row link-row-install" id="installLink" type="button" hidden>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 4v11M7 11l5 5 5-5M5 20h14" />
                </svg>
                Install the AeroNav app
              </button>
              <a class="link-row" href="/donate" target="_blank">Donate to AeroNav</a>
              <a class="link-row" href="https://tico09.com/24SPY" target="_blank">24Spy</a>
              <a class="link-row" href="https://24pilot.ptfsrp.com" target="_blank">24Pilot</a>
              <a class="link-row" href="https://flighteye.awdevsoftware.org/" target="_blank">FlightEye</a>
              <a class="link-row" href="https://discord.com/oauth2/authorize?client_id=1537343054237933638" target="_blank" rel="noopener">Discord bot</a>
              <a class="link-row" href="https://tally.so/r/RWdl7J" target="_blank" rel="noopener">Report a chart error</a>
            </div>
          </div>
        </section>
      </aside>

      <main class="viewer">
        <div class="viewer-bar">
          <div class="viewer-heading">
            <div class="viewer-title" id="viewerTitle">ENROUTE CHART</div>
            <div class="viewer-sub" id="viewerSub">ENROUTE</div>
          </div>
          <div class="controls">
            <div class="bar-group bar-links">
              <a class="bar-btn" href="https://flighteye.awdevsoftware.org/" target="_blank" rel="noopener">FlightEye</a>
              <a class="bar-btn" href="https://24pilot.ptfsrp.com" target="_blank" rel="noopener">24Pilot</a>
            </div>
            <span class="bar-sep" aria-hidden="true"></span>
            <div class="bar-group">
              <button class="bar-btn" id="pinCurrent" aria-label="Pin this chart" title="Pin chart">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M9 3h6l-1 5 3 3v2H7v-2l3-3-1-5Z" />
                  <path d="M12 13v8" />
                </svg>
                <span>Pin</span>
              </button>
              <a class="bar-btn bar-report" href="https://tally.so/r/RWdl7J" target="_blank" rel="noopener">Report error</a>
            </div>
            <span class="bar-sep" aria-hidden="true"></span>
            <a class="bar-btn donate-btn" href="/donate" target="_blank">Donate</a>
          </div>
        </div>

        <div class="iframe-wrap">
          <div class="chart-tools" aria-label="Chart tools">
            <button class="icon-btn" id="fullscreenBtn" aria-label="Fullscreen" title="Fullscreen">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
              </svg>
            </button>
            <button class="icon-btn zoom-tool" id="zoomInBtn" aria-label="Zoom in" title="Zoom in">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.6-3.6M11 8v6M8 11h6" />
              </svg>
            </button>
            <button class="icon-btn zoom-tool" id="zoomOutBtn" aria-label="Zoom out" title="Zoom out">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.6-3.6M8 11h6" />
              </svg>
            </button>
            <button class="icon-btn zoom-tool" id="zoomFitBtn" aria-label="Fit chart to screen" title="Fit to screen">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.6-3.6" />
                <rect x="8" y="8.5" width="6" height="5" rx="0.8" />
              </svg>
            </button>
            <button class="icon-btn zoom-tool" id="rotateLeftBtn" aria-label="Rotate chart left" title="Rotate left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="11" width="11" height="9" rx="1.5" />
                <path d="M15 5.5A8.5 8.5 0 0 0 4.5 12" />
                <path d="m2 9.5 2.5 2.7 2.8-2.4" />
              </svg>
            </button>
            <button class="icon-btn zoom-tool" id="rotateRightBtn" aria-label="Rotate chart right" title="Rotate right">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="11" width="11" height="9" rx="1.5" />
                <path d="M9 5.5A8.5 8.5 0 0 1 19.5 12" />
                <path d="m22 9.5-2.5 2.7-2.8-2.4" />
              </svg>
            </button>
            <button class="icon-btn zoom-tool" id="drawBtn" aria-label="Draw on chart" title="Draw on chart" aria-pressed="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 20l4-1 11-11-3-3L5 16l-1 4Z" />
                <path d="m14 6 3 3" />
              </svg>
            </button>
            <button class="icon-btn zoom-tool" id="ownshipBtn" aria-label="Show my aircraft" title="Show my aircraft" aria-pressed="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
                <path d="M12 3c.9 0 1.5 1.1 1.5 2.5V10l7 4.3v2l-7-2.1v3.6l2.2 1.7V21L12 20l-3.7 1v-1.5l2.2-1.7v-3.6l-7 2.1v-2l7-4.3V5.5C10.5 4.1 11.1 3 12 3Z" />
              </svg>
            </button>
            <button class="icon-btn" id="shareBtn" aria-label="Copy link" title="Copy link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="18" cy="5" r="2.5" />
                <circle cx="6" cy="12" r="2.5" />
                <circle cx="18" cy="19" r="2.5" />
                <path d="m8.3 13.4 7.4 4.2M15.7 6.4 8.3 10.6" />
              </svg>
            </button>
          </div>
          <div id="viewerLoading" class="viewer-loading" style="display: none;">
            <div class="loader-content">
              <LoaderLogo />
              <div class="spinner"></div>
              <div class="loading-text">Loading chart...</div>
            </div>
          </div>
          <div class="zoom-readout" id="zoomReadout" aria-live="polite" hidden></div>
          <button class="ownship-chip" id="ownshipChip" type="button" title="Change pilot name" hidden></button>
          <iframe id="viewerFrame" src="about:blank" title="AeroNav chart viewer"></iframe>
        </div>

        <div class="pinboard" id="pinboard" aria-label="Pinboard">
          <button class="pinboard-new" id="newScratchpad" title="New scratchpad" aria-label="New scratchpad">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="5" y="4" width="14" height="17" rx="2" />
              <path d="M9 2.5v3M12 2.5v3M15 2.5v3M8.5 10h7M8.5 13.5h7M8.5 17h4" />
            </svg>
          </button>
          <div class="pinboard-scroll" id="pinnedRow" role="list"></div>
          <button class="ghost-btn text pinboard-clear" id="clearPinned" style="display: none;" title="Unpin all charts">Clear</button>
        </div>

        <div class="ad" id="siteAd" role="complementary" aria-label="Sponsored">
          <span class="ad-label">Sponsored</span>
          <a href="https://tally.so/r/nW6RKa" target="_blank" rel="noopener">Thank you for supporting AeroNav. Contact us to get an ad of your own.</a>
          <button class="ad-close" id="adCloseBtn" aria-label="Hide ad">&times;</button>
        </div>
      </main>
    </div>

    <button class="fab" id="quickActionsBtn" aria-label="Quick actions">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="6" x2="12" y2="18" />
        <line x1="6" y1="12" x2="18" y2="12" />
      </svg>
    </button>

    <div class="bottom-sheet" id="quickActionsSheet">
      <div class="bottom-sheet-handle"></div>
      <div class="bottom-sheet-content">
        <h3 class="bottom-sheet-title">Quick actions</h3>
        <div class="quick-actions-grid">
          <button class="quick-action-btn" id="quickHome">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M3 10.5 12 3l9 7.5" />
              <path d="M5 9.5V21h14V9.5" />
            </svg>
            <span>Home</span>
          </button>
          <button class="quick-action-btn" id="quickFullscreen">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
            </svg>
            <span>Fullscreen</span>
          </button>
          <button class="quick-action-btn" id="quickRotate">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
