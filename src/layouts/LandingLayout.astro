---
import { versioned } from '../lib/assets.js';
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import IntroScreen from '../components/IntroScreen.astro';

interface Props {
  title: string;
  description: string;
  keywords: string;
  bodyClass?: string;
  intro?: boolean;
}

const { title, description, keywords, bodyClass, intro = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      keywords={keywords}
      fonts="family=B612:wght@400;700&family=Inter:wght@400;500;600"
      stylesheet="/css/home.css"
    />
  </head>
  <body class={bodyClass}>
    {intro && <IntroScreen />}
    <div class="landing-wrap">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <slot name="footer" />
    </div>
    <slot name="scripts" />
    <script is:inline src={versioned("/js/site-nav.js")}></script>
  </body>
</html>
