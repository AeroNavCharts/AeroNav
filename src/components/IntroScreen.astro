---
import LoaderLogo from './LoaderLogo.astro';
---

<noscript>
  <style>
    .intro-screen {
      display: none;
    }
  </style>
</noscript>

<div class="intro-screen" id="introScreen" aria-hidden="true">
  <LoaderLogo />
</div>

<script is:inline>
  (function () {
    var intro = document.getElementById('introScreen');
    if (!intro) return;
    var started = performance.now();
    var done = false;
    var finish = function () {
      if (done) return;
      done = true;
      intro.classList.add('is-done');
      setTimeout(function () {
        intro.remove();
      }, 450);
    };
    var whenLoaded = function () {
      setTimeout(finish, Math.max(0, 1150 - (performance.now() - started)));
    };
    if (document.readyState === 'complete') whenLoaded();
    else window.addEventListener('load', whenLoaded);
    setTimeout(finish, 3500);
  })();
</script>

<style is:global>
  .intro-screen {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--night);
    transition: opacity 0.4s ease, visibility 0.4s;
  }

  .intro-screen .loader-logo {
    height: 52px;
    margin: 0;
  }

  .intro-screen.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
</style>
