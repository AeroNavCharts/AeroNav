---
import { versioned } from '../lib/assets.js';
import { discordEmbed } from '../lib/discordEmbed.js';
interface Props {
  title: string;
  description: string;
  keywords: string;
  fonts: string;
  stylesheet: string;
  shareTitle?: string;
}

const { title, description, keywords, fonts, stylesheet, shareTitle = title } = Astro.props;

const pageUrl = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href;
const shareImage = new URL('/assets/og-banner.png', Astro.site).href;
const embedImage = new URL('/assets/og-banner.gif', Astro.site).href;
const embedJson = discordEmbed({ heading: shareTitle, text: description, image: embedImage, site: Astro.site });
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content={description} />
<meta name="author" content="AeroNav" />
<meta name="keywords" content={keywords} />
<meta name="theme-color" content="#1f2a38" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="192x192" href="/assets/icons/icon-192.png" />
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="AeroNav" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<link rel="canonical" href={pageUrl} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="AeroNav" />
<meta property="og:title" content={shareTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<script is:inline id="discord:component-embed" type="application/json" set:html={embedJson} />
<link rel="preload" href={versioned(stylesheet)} as="style" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />
<link rel="stylesheet" href={versioned(stylesheet)} />
<title>{title}</title>
{import.meta.env.PROD && (
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    }
  </script>
)}
