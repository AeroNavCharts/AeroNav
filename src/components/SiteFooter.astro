---
interface Props {
  credits?: boolean;
}

const { credits = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <div>
      <img class="footer-logo" src="/assets/logo-full.webp" alt="AeroNav" width="212" height="30" />
      <p class="footer-text">
        &copy; {year} AeroNav. All rights reserved.
        {credits && (
          <Fragment>
            Initial UI by <a href="https://discord.com/users/1028160951125557258" target="_blank" rel="noopener">sweet_kid</a>.<br />
            Redesigned and hand built by <a href="https://awdevsoftware.org" target="_blank" rel="noopener">awdevSoftware</a>.
          </Fragment>
        )}
      </p>
    </div>
    <div class="footer-links">
      <slot />
    </div>
  </div>
</footer>
