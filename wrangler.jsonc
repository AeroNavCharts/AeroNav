{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeronav-astro",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/chart-file/*"]
  }
}
